[Unit]
Description=Tunnel Server
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tun c
ExecStop=/usr/bin/tun d
Restart=on-failure
RestartSec=5

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
